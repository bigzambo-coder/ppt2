# Claude API — content generation quality. Without it, the app falls back to
# deterministic template content (still fully usable, just less tailored).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Naver Search API (free tier: https://developers.naver.com) — used to research the
# target institution for facts + brand color. Without these, research silently no-ops.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Simple access-code gate for the public deployment (HTTP Basic Auth). Leave unset for
# local dev to skip the gate entirely.
ACCESS_CODE=
